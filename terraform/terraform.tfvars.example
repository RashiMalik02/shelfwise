# Copy to terraform.tfvars (git-ignored) and adjust.
# Credentials do NOT go here - use `aws configure` or AWS_PROFILE.

# New-sign-up AWS accounts are locked to one region (India -> ap-southeast-2).
aws_region   = "ap-southeast-2"
environment  = "dev"
owner        = "your-name"
cluster_name = "shelfwise-eks"

# Cheapest setup that still demonstrates everything:
node_instance_types = ["c7i-flex.large"]   # Free Tier eligible; t3.medium is not
node_capacity_type  = "ON_DEMAND"   # SPOT is ~65% cheaper where your account allows it
node_desired_size   = 2
single_nat_gateway  = true

# Lock the Kubernetes API to your own IP (curl -s https://checkip.amazonaws.com):
# cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]
